#-------------------------------------------------------------
# apps/qr — GÖMÜLÜ kurulum .env şablonu (barlas-trailer altında /qr)
# Kullanım:  cp env.embedded.example .env   → domain + parolayı düzenle.
# Gerçek .env git'e GİRMEZ (apps/qr/.gitignore).
#
# DİKKAT: Bu anahtarları compose environment'ına TAŞIMA — konteyner
# ortam değişkenleri iki CI4 uygulamasına birden görünür ve ana sitenin
# SQLite konfigürasyonunu ezer. CI_ENVIRONMENT de konteynerden gelir.
#-------------------------------------------------------------

app.baseURL = 'http://localhost:8080/qr/'
# prod: app.baseURL = 'https://DOMAIN/qr/'
app.indexPage = ''
app.appTimezone = 'Europe/Istanbul'

# Ana sitenin ci_session çerezi ile çakışmasın; çerez /qr'a sınırlı kalsın.
session.cookieName = 'qr_session'
cookie.path = '/qr'

database.default.hostname = db
database.default.database = qr_sistemi
database.default.username = apps
database.default.password = apps_pass
# prod: kök .env'deki APPS_DB_PASSWORD ile aynı değeri yaz.
database.default.DBDriver = MySQLi
database.default.port = 3306

#=== Özellik bayrakları ======================================
feature.qrDynamic = true
feature.fixedQrRegenLimit = 3
feature.maxLocations = 5
