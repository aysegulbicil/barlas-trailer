#--------------------------------------------------------------------
# Barlas Trailer — ÜRETİM .env şablonu
#
# Sunucuda:  cp env.production.example .env  → domaini düzelt.
# (.env gitignore'dadır ve asla commit edilmez; bu şablon versiyonlanır.)
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP — BARLAS-DOMAIN.com'u kendi alan adınla değiştir
#--------------------------------------------------------------------
app.baseURL = 'https://BARLAS-DOMAIN.com/'
app.forceGlobalSecureRequests = true

# Oturum çerezi (panel girişi dahil) yalnız HTTPS üzerinden taşınsın
cookie.secure = true

#--------------------------------------------------------------------
# DATABASE — kimlikli dünya (panel/Shield) SQLite'ı.
# Kamusal sayfalar DB kullanmaz; dosya ilk "spark migrate --all" ile oluşur.
#--------------------------------------------------------------------
database.default.DBDriver = SQLite3
database.default.database = /var/www/html/writable/db/barlas.sqlite
database.default.foreignKeys = true
